;; IAR device description file

;; Memory information ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;;
;; Used to define address zones within the ARM address space (Memory).
;;
;;   Name      may be almost anything
;;   AdrSpace  must be Memory
;;   StartAdr  start of memory block
;;   EndAdr    end of memory block
;;   AccType   type of access, read-only (R), read-write (RW) or SFR (W)

[Memory]
;;       =  Name         AdrSpace  StartAdr    EndAdr      AccType
Memory = FLASH        Memory    0x00000000  0x0001FFFF  RW
Memory = RWW          Memory    0x00400000  0x00400FFF  RW
Memory = CAL          Memory    0x00800000  0x00800007  R
Memory = LOCKBIT      Memory    0x00802000  0x00802003  R
Memory = USER_PAGE    Memory    0x00804000  0x008040FF  RW
Memory = OTP1         Memory    0x00806000  0x00806007  R
Memory = OTP2         Memory    0x00806008  0x0080600F  R
Memory = OTP3         Memory    0x00806010  0x00806017  R
Memory = OTP4         Memory    0x00806018  0x0080601F  R
Memory = OTP5         Memory    0x00806020  0x00806027  R
Memory = TEMP_LOG     Memory    0x00806030  0x00806037  R
Memory = HSRAM        Memory    0x20000000  0x20003FFF  RW
Memory = HPB0         Memory    0x40000000  0x40003FFF  RW
Memory = PERIPHERALS  Memory    0x40000000  0x5FFFFFFF  RW
Memory = HPB1         Memory    0x41000000  0x4100FFFF  RW
Memory = HPB2         Memory    0x42000000  0x42007FFF  RW
Memory = HPB3         Memory    0x43000000  0x43007FFF  RW
Memory = DIVAS        Memory    0x48000000  0x4800001F  RW
Memory = PPB          Memory    0xE0000000  0xE00FFFFF  RW
Memory = SCS          Memory    0xE000E000  0xE000EFFF  RW

TrustedRanges = true
UseSfrFilter = true

[InterruptList]
Interrupt = SYSTEM 0x0
Interrupt = WDT 0x1
Interrupt = RTC 0x2
Interrupt = EIC 0x3
Interrupt = FREQM 0x4
Interrupt = TSENS 0x5
Interrupt = NVMCTRL 0x6
Interrupt = DMAC 0x7
Interrupt = EVSYS 0x8
Interrupt = SERCOM0_6 0x9
Interrupt = SERCOM1_7 0xA
Interrupt = SERCOM2 0xB
Interrupt = SERCOM3 0xC
Interrupt = SERCOM4 0xD
Interrupt = SERCOM5 0xE
Interrupt = CAN0 0xF
Interrupt = CAN1 0x10
Interrupt = TCC0 0x11
Interrupt = TCC1 0x12
Interrupt = TCC2 0x13
Interrupt = TC0_5 0x14
Interrupt = TC1_6 0x15
Interrupt = TC2_7 0x16
Interrupt = TC3 0x17
Interrupt = TC4 0x18
Interrupt = ADC0 0x19
Interrupt = ADC1 0x1A
Interrupt = AC 0x1B
Interrupt = DAC 0x1C
Interrupt = SDADC 0x1D
Interrupt = PTC 0x1E

[Sfr]
sfr = "AC_CTRLA", "Memory", 0x42005000, 1, base=16, tooltip="Control A"
sfr = "AC_CTRLA.SWRST", "Memory", 0x42005000, 1, base=16, bitShift="8,0x1", tooltip="Control A"
